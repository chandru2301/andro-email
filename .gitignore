# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# andro email
# Local SQLite database and the workspace-local package-manager caches used
# when the global cache is not writable.
/.data/
/.cache/

# SQLite files, wherever they land (e.g. a stray ANDRO_DB_DIR at the repo root).
*.db
*.db-shm
*.db-wal

