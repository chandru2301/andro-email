# Andro Email — environment
#
# The app runs with NO configuration: it seeds a fixture corpus and ranks it
# with the deterministic rules engine. Everything below is opt-in.

# --- DeepSeek (the decision engine) -----------------------------------------
# Without this key the app runs the rules engine and says so in the UI.
DEEPSEEK_API_KEY=sk-2ecf36b38ce44782bd51028738f8bbb4

# Model names live in config and nowhere else — DeepSeek retires and renames
# models (legacy deepseek-v4-flash is now served by V4.1-Flash).
DEEPSEEK_MODEL_FLASH=deepseek-flash
DEEPSEEK_MODEL_PRO=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- Owner ------------------------------------------------------------------
# Used to detect "directly addressed to you" and "sent by you".
ANDRO_OWNER_EMAIL=chandru.v2301@gmail.com

# --- Storage ----------------------------------------------------------------
# SQLite lives here. Defaults to ./.data
# ANDRO_DB_DIR=            # unset = ./.data (leave commented)

# --- IMAP (app password) ----------------------------------------------------
# The simplest way to read a real mailbox. Works with a Google "app password".
#
# This password is a long-lived secret with full mailbox access. It is read from
# the environment only — never written to the database, never logged, never sent
# anywhere but the IMAP server. Keep this file out of version control
# (.env* is already gitignored).
#
# Gmail setup:
#   1. Enable 2-Step Verification on your Google account.
#   2. Go to https://myaccount.google.com/apppasswords and create one.
#   3. Paste it below — the spaces Google shows are stripped automatically.
#
# Leave these blank to run on the bundled fixture corpus instead.
IMAP_USER=
IMAP_PASSWORD=
# Defaults target Gmail. Override for any other IMAP provider.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_SECURE=true
# INBOX, or "[Gmail]/All Mail" to include archived mail.
IMAP_MAILBOX=INBOX
# How many of the newest messages to pull. Keep this modest on first run.
IMAP_LIMIT=60

# --- Gmail API (OAuth, optional alternative) --------------------------------
# Read-only scopes only: the app can apply labels but can never send mail.
# NOTE: gmail.readonly is a Google *restricted* scope — past a small number of
# users it requires a CASA security assessment. In testing mode, add yourself
# as a test user and it works immediately.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/gmail/callback
